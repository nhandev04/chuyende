# Backend Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# Security & Authentication
SECRET_KEY=health_ai_secret_key_super_secure_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite:///./health_app.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Clerk Auth API Keys (Get from https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Cloudinary Configuration (Get from https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=rohl7aqf
CLOUDINARY_API_KEY=396177385619527
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://396177385619527:your_cloudinary_api_secret_here@rohl7aqf

# Google Gemini AI Key (Get free 100% at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
